# Supabase (required)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Public address of this site, used in email links and QR codes (required in production), e.g. https://network.example.org
NEXT_PUBLIC_SITE_URL=
# Server only. Needed for inviting people from the People and Access screen. Never expose this key to the browser.
SUPABASE_SERVICE_ROLE_KEY=
# Email notifications (optional; nothing is sent without these). Resend: https://resend.com
RESEND_API_KEY=
EMAIL_FROM=
# SMS notifications (optional). Africa's Talking
AT_USERNAME=
AT_API_KEY=
AT_SENDER_ID=
# Any long random text. Used to hash visitor addresses for the form throttle.
THROTTLE_SALT=
# Asks search engines not to list the site while it is a prototype. On unless set to off. Set to off only after MRI has approved a real launch.
NEXT_PUBLIC_PROTOTYPE_MODE=on
